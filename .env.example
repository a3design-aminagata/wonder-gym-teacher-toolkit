# 共通
LOGIN_EMAIL=your@email.address
LOGIN_PASSWORD=your_password
NAME=your_name
LMS_BASE_URL=https://your-lms.example.com

# Notion
NOTION_SCHEDULE_URL=https://www.notion.so/your_workspace/your_view_id
NOTION_BASE_URL=https://YOUR_NOTION_WORKSPACE.notion.site

# orphan-override-maker（任意）
AUTO_PENDING_LESSON_URL=https://meet.google.com/your-room-code

# Google Sheets（apply-message-maker）
CERTIFIED_SHEET_GVIZ_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:json&sheet=YOUR_SHEET_NAME&tq=select%20D

# 請求自動化
DOWNLOAD_DIR=~/Downloads

# 任意: 会社ごとの送付先
INVOICE_SEND_TO_PRIMARY=invoice@example.com
INVOICE_SEND_TO_SECONDARY=invoice-alt@example.com

# Google OAuth ファイル（ローカル専用、コミット禁止）
# CREDENTIALS_FILE=credentials.json
